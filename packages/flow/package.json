{
  "name": "@datatechsolutions/tympan-flow",
  "version": "0.1.0",
  "description": "Tympan flow and provenance canvas: accessible React 19 graph viewer and DAG editor (W3C PROV provenance graph with a synced tree, workflow editor, run inspection), on @datatechsolutions/tympan. Plain CSS in @layer tympan.components.",
  "license": "FSL-1.1-ALv2",
  "author": "Natalia Mesquita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datatechsolutionsbr/tympan.git",
    "directory": "packages/flow"
  },
  "keywords": [
    "react",
    "graph",
    "dag",
    "workflow-editor",
    "provenance",
    "w3c-prov",
    "accessibility",
    "canvas"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tympan-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w @datatechsolutions/tympan-tokens",
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build -w @datatechsolutions/tympan-tokens && vite --config gallery/vite.config.ts",
    "gallery:build": "npm run build -w @datatechsolutions/tympan-tokens && vite build --config gallery/vite.config.ts",
    "pretest": "npm run build -w @datatechsolutions/tympan-tokens",
    "pretypecheck": "npm run build -w @datatechsolutions/tympan-tokens",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@datatechsolutions/tympan": "^0.1.0",
    "@datatechsolutions/tympan-tokens": "^0.1.0",
    "lucide-react": "^1.48.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  },
  "homepage": "https://github.com/datatechsolutionsbr/tympan#readme",
  "bugs": {
    "url": "https://github.com/datatechsolutionsbr/tympan/issues"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
