{
  "name": "@datatechsolutions/tympan",
  "version": "0.1.0",
  "description": "Tympan: accessible React components (React 18.3 or 19) on React Aria Components, styled with --ty-* CSS custom properties in @layer tympan. The flow and provenance canvas (graph viewer, DAG editor, run inspection) ships as the @datatechsolutions/tympan/flow subpath. Generated avatars (DiceBear, CC0/MIT styles only) ship as the /avatars subpath and country and region flags as the /flags subpath.",
  "license": "FSL-1.1-ALv2",
  "author": "Natalia Mesquita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datatechsolutionsbr/tympan.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "design-system",
    "accessibility",
    "react-aria",
    "design-tokens",
    "css-custom-properties",
    "rtl",
    "i18n",
    "graph",
    "dag",
    "workflow-editor",
    "provenance",
    "w3c-prov",
    "avatar",
    "dicebear",
    "flags"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tympan-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flow": {
      "tympan-source": "./src/flow/index.ts",
      "types": "./dist/flow.d.ts",
      "default": "./dist/flow.js"
    },
    "./avatars": {
      "tympan-source": "./src/avatars/index.ts",
      "types": "./dist/avatars.d.ts",
      "default": "./dist/avatars.js"
    },
    "./flags": {
      "tympan-source": "./src/flags/index.ts",
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./styles.css": "./dist/styles.css",
    "./flow.css": "./dist/flow.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w @datatechsolutions/tympan-tokens && node scripts/build-flags.mjs",
    "build": "tsdown && node scripts/build-css.mjs && node scripts/prune-flag-maps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build -w @datatechsolutions/tympan-tokens && node scripts/build-flags.mjs && vite --config gallery/vite.config.ts",
    "gallery:build": "npm run build -w @datatechsolutions/tympan-tokens && node scripts/build-flags.mjs && vite build --config gallery/vite.config.ts",
    "pretest": "npm run build -w @datatechsolutions/tympan-tokens && node scripts/build-flags.mjs",
    "pretypecheck": "npm run build -w @datatechsolutions/tympan-tokens && node scripts/build-flags.mjs"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dicebear/core": "^9.4.3",
    "@dicebear/glass": "^9.4.3",
    "@dicebear/icons": "^9.4.3",
    "@dicebear/identicon": "^9.4.3",
    "@dicebear/initials": "^9.4.3",
    "@dicebear/lorelei": "^9.4.3",
    "@dicebear/lorelei-neutral": "^9.4.3",
    "@dicebear/notionists": "^9.4.3",
    "@dicebear/notionists-neutral": "^9.4.3",
    "@dicebear/open-peeps": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.3",
    "@dicebear/pixel-art-neutral": "^9.4.3",
    "@dicebear/rings": "^9.4.3",
    "@dicebear/shapes": "^9.4.3",
    "@dicebear/thumbs": "^9.4.3",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    },
    "@dicebear/core": {
      "optional": true
    },
    "@dicebear/glass": {
      "optional": true
    },
    "@dicebear/icons": {
      "optional": true
    },
    "@dicebear/identicon": {
      "optional": true
    },
    "@dicebear/initials": {
      "optional": true
    },
    "@dicebear/lorelei": {
      "optional": true
    },
    "@dicebear/lorelei-neutral": {
      "optional": true
    },
    "@dicebear/notionists": {
      "optional": true
    },
    "@dicebear/notionists-neutral": {
      "optional": true
    },
    "@dicebear/open-peeps": {
      "optional": true
    },
    "@dicebear/pixel-art": {
      "optional": true
    },
    "@dicebear/pixel-art-neutral": {
      "optional": true
    },
    "@dicebear/rings": {
      "optional": true
    },
    "@dicebear/shapes": {
      "optional": true
    },
    "@dicebear/thumbs": {
      "optional": true
    }
  },
  "dependencies": {
    "@datatechsolutions/tympan-tokens": "0.1.0",
    "@internationalized/date": "^3.12.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/topojson-client": "^3.1.5",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.48.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "roughjs": "^4.6.6",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dicebear/core": "^9.4.3",
    "@dicebear/glass": "^9.4.3",
    "@dicebear/icons": "^9.4.3",
    "@dicebear/identicon": "^9.4.3",
    "@dicebear/initials": "^9.4.3",
    "@dicebear/lorelei": "^9.4.3",
    "@dicebear/lorelei-neutral": "^9.4.3",
    "@dicebear/notionists": "^9.4.3",
    "@dicebear/notionists-neutral": "^9.4.3",
    "@dicebear/open-peeps": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.3",
    "@dicebear/pixel-art-neutral": "^9.4.3",
    "@dicebear/rings": "^9.4.3",
    "@dicebear/shapes": "^9.4.3",
    "@dicebear/thumbs": "^9.4.3",
    "@types/d3-geo": "^3.1.1",
    "axe-core": "^4.13.0",
    "flag-icons": "7.5.0"
  }
}
