{
  "name": "@fakhir/design-system",
  "version": "0.1.0",
  "description": "Fakhir design system: accessible React 19 components on React Aria Components, styled with --fk-* CSS custom properties in @layer fakhir. No Tailwind.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "fakhir-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w @fakhir/tokens",
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build -w @fakhir/tokens && vite --config gallery/vite.config.ts",
    "gallery:build": "npm run build -w @fakhir/tokens && vite build --config gallery/vite.config.ts",
    "pretest": "npm run build -w @fakhir/tokens",
    "pretypecheck": "npm run build -w @fakhir/tokens"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@fakhir/tokens": "0.1.0",
    "lucide-react": "^1.48.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
