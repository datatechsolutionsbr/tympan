{
  "name": "@datatechsolutions/tympan",
  "version": "0.1.0",
  "description": "Tympan: accessible React components (React 18.3 or 19) on React Aria Components, styled with --ty-* CSS custom properties in @layer tympan.",
  "license": "FSL-1.1-ALv2",
  "author": "Natalia Mesquita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datatechsolutionsbr/tympan.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "design-system",
    "accessibility",
    "react-aria",
    "design-tokens",
    "css-custom-properties",
    "rtl",
    "i18n"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tympan-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w @datatechsolutions/tympan-tokens",
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build -w @datatechsolutions/tympan-tokens && vite --config gallery/vite.config.ts",
    "gallery:build": "npm run build -w @datatechsolutions/tympan-tokens && vite build --config gallery/vite.config.ts",
    "pretest": "npm run build -w @datatechsolutions/tympan-tokens",
    "pretypecheck": "npm run build -w @datatechsolutions/tympan-tokens"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@datatechsolutions/tympan-tokens": "0.1.0",
    "@internationalized/date": "^3.12.4",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.48.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "axe-core": "^4.13.0"
  }
}
