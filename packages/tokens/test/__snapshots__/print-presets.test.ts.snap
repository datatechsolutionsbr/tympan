  --ty-print-tremor: 0;
  --ty-print-raio: 0mm;
  --ty-print-titulo-caixa: none;
  --ty-print-titulo-espaco: normal;
  --ty-print-rotulo-caixa: none;
  --ty-print-rotulo-variante: normal;
  --ty-print-rotulo-espaco: normal;
}
"
`;
