  --ty-print-prova-pendente: #5d5d5d;
  --ty-print-prova-sem-dado: #5d5d5d;
  --ty-print-prova-nao-testada: #5d5d5d;
  --ty-print-textura-intensidade: 0;
  --ty-print-traco: 0.3mm;
  --ty-print-tremor: 0;
  --ty-print-raio: 0mm;
  --ty-print-titulo-caixa: none;
  --ty-print-titulo-espaco: normal;
  --ty-print-rotulo-caixa: uppercase;
  --ty-print-rotulo-variante: normal;
  --ty-print-rotulo-espaco: 0.07em;
}
"
`;
