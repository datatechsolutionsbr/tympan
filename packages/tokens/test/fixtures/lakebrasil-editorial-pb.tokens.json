{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "lakebrasil edições (P&B). Tema de livro do selo lakebrasil edições, versão papel-claro do sistema dos vídeos Brasil Real. Herda 'semanario' e sobrescreve só o que está aqui (formato PrintStyleOverrides; ver README.md).",
  "$extensions": {
    "dev.tympan.print": {
      "name": "lakebrasil-editorial-pb",
      "extends": "semanario",
      "formato": "PrintStyleOverrides",
      "versao": "2",
      "pesos": {
        "titulo": 600,
        "numero": 600,
        "rotulo": 600,
        "corpo": 400,
        "anotacao": 400,
        "mono": 400
      },
      "algarismos": "tabular-nums em numero e rotulo",
      "dado": {
        "interesse": "#1a1a1a",
        "contexto": "#d4d4d4",
        "ganhou": "#555555",
        "ganhouClaro": "#bbbbbb",
        "perdeu": "#000000",
        "perdeuClaro": "#888888"
      },
      "regras": [
        "série de interesse em tinta cheia, contexto em cinza",
        "divergente azul × laranja",
        "nenhuma cor de dado a menos de ΔE2000 10 das cores do logo",
        "estado = palavra + borda + ícone, nunca só cor"
      ]
    }
  },
  "label": {
    "$type": "string",
    "$value": "lakebrasil edições (P&B)"
  },
  "fontes": {
    "titulo": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "numero": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "corpo": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "rotulo": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "anotacao": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "googleFonts": {
    "$type": "string[]",
    "$value": [
      "Source Serif 4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400",
      "IBM Plex Sans:ital,wght@0,400;0,500;0,600;0,700;1,400",
      "IBM Plex Mono:wght@400"
    ]
  },
  "cor": {
    "papel": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "tinta": {
      "$type": "color",
      "$value": "#1a1a1a"
    },
    "tinta2": {
      "$type": "color",
      "$value": "#333333"
    },
    "tinta3": {
      "$type": "color",
      "$value": "#5c5c5c"
    },
    "linha": {
      "$type": "color",
      "$value": "#bdbdbd"
    },
    "destaque": {
      "$type": "color",
      "$value": "#1a1a1a"
    },
    "destaque2": {
      "$type": "color",
      "$value": "#bdbdbd"
    },
    "marcaTexto": {
      "$type": "color",
      "$value": "#eeeeee"
    },
    "contexto": {
      "$type": "color",
      "$value": "#d4d4d4"
    },
    "prova": {
      "sustentada": {
        "$type": "color",
        "$value": "#1a1a1a"
      },
      "refutada": {
        "$type": "color",
        "$value": "#1a1a1a"
      },
      "nao-da-para-afirmar": {
        "$type": "color",
        "$value": "#1a1a1a"
      },
      "pendente": {
        "$type": "color",
        "$value": "#1a1a1a"
      },
      "sem-dado": {
        "$type": "color",
        "$value": "#1a1a1a"
      },
      "nao-testada": {
        "$type": "color",
        "$value": "#1a1a1a"
      }
    }
  },
  "traco": {
    "largura": {
      "$type": "number",
      "$value": 0.3
    }
  },
  "marcaProva": {
    "$type": "string",
    "$value": "etiqueta"
  },
  "raio": {
    "$type": "number",
    "$value": 0
  },
  "caixaAlta": {
    "$type": "boolean",
    "$value": false
  },
  "pb": {
    "destaque": {
      "$type": "color",
      "$value": "#1c1a17"
    },
    "destaque2": {
      "$type": "color",
      "$value": "#9a948a"
    }
  },
  "estrutura": {
    "painel": {
      "$type": "string",
      "$value": "fio"
    },
    "rotulo": {
      "$type": "string",
      "$value": "letra"
    },
    "figura": {
      "$type": "string",
      "$value": "barra-topo"
    },
    "notas": {
      "$type": "string",
      "$value": "dentro"
    },
    "multiplos": {
      "$type": "string",
      "$value": "lado-a-lado"
    }
  },
  "logo": {
    "$type": "string",
    "$value": "mono"
  }
}