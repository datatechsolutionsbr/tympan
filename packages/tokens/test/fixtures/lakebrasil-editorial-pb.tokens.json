{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "lakebrasil edições (semanário, P&B). Tema de livro do selo lakebrasil edições. Herda o preset tympan-print 'semanario' e sobrescreve só o que está aqui (formato PrintStyleOverrides; ver README.md).",
  "$extensions": {
    "dev.tympan.print": {
      "name": "lakebrasil-editorial-pb",
      "extends": "semanario",
      "formato": "PrintStyleOverrides",
      "versao": "1"
    }
  },
  "label": {
    "$type": "string",
    "$value": "lakebrasil edições (semanário, P&B)"
  },
  "fontes": {
    "titulo": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "corpo": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "numero": {
      "$type": "fontFamily",
      "$value": [
        "Fira Sans Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    },
    "rotulo": {
      "$type": "fontFamily",
      "$value": [
        "Fira Sans Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    },
    "anotacao": {
      "$type": "fontFamily",
      "$value": [
        "Fira Sans Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Fira Sans Condensed",
        "Arial Narrow",
        "sans-serif"
      ]
    }
  },
  "googleFonts": {
    "$type": "string[]",
    "$value": [
      "Fira Sans Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400",
      "Source Serif 4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400"
    ]
  },
  "cor": {
    "papel": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "tinta": {
      "$type": "color",
      "$value": "#000000"
    },
    "tinta2": {
      "$type": "color",
      "$value": "#262626"
    },
    "tinta3": {
      "$type": "color",
      "$value": "#555555"
    },
    "linha": {
      "$type": "color",
      "$value": "#9a9a9a"
    },
    "destaque": {
      "$type": "color",
      "$value": "#000000"
    },
    "destaque2": {
      "$type": "color",
      "$value": "#b3b3b3"
    },
    "marcaTexto": {
      "$type": "color",
      "$value": "#e6e6e6"
    },
    "contexto": {
      "$type": "color",
      "$value": "#b3b3b3"
    },
    "prova": {
      "sustentada": {
        "$type": "color",
        "$value": "#000000"
      },
      "refutada": {
        "$type": "color",
        "$value": "#000000"
      },
      "nao-da-para-afirmar": {
        "$type": "color",
        "$value": "#000000"
      },
      "pendente": {
        "$type": "color",
        "$value": "#555555"
      },
      "sem-dado": {
        "$type": "color",
        "$value": "#555555"
      },
      "nao-testada": {
        "$type": "color",
        "$value": "#555555"
      }
    }
  },
  "traco": {
    "largura": {
      "$type": "number",
      "$value": 0.3
    }
  },
  "marcaProva": {
    "$type": "string",
    "$value": "barra"
  },
  "raio": {
    "$type": "number",
    "$value": 0
  },
  "caixaAlta": {
    "$type": "boolean",
    "$value": false
  },
  "pb": {
    "destaque": {
      "$type": "color",
      "$value": "#121212"
    },
    "destaque2": {
      "$type": "color",
      "$value": "#9a9a9a"
    }
  },
  "estrutura": {
    "painel": {
      "$type": "string",
      "$value": "fio"
    },
    "rotulo": {
      "$type": "string",
      "$value": "quadrado"
    },
    "figura": {
      "$type": "string",
      "$value": "barra-topo"
    },
    "notas": {
      "$type": "string",
      "$value": "dentro"
    },
    "multiplos": {
      "$type": "string",
      "$value": "lado-a-lado"
    }
  },
  "logo": {
    "$type": "string",
    "$value": "mono"
  }
}