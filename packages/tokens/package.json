{
  "name": "@datatechsolutions/tympan-tokens",
  "version": "0.3.0",
  "description": "Tympan design tokens: W3C DTCG source (colour, space, radius, type, elevation and glass, motion, z) and an OKLCH theme generator, with the tympan, fakhir, astrlabe, neutral and high-contrast presets in light and dark (plus opt-in UI themes derived from the print book styles), built to --ty-* CSS custom properties, JSON and a TypeScript export.",
  "license": "FSL-1.1-ALv2",
  "author": "Natalia Mesquita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datatechsolutionsbr/tympan.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "oklch",
    "theme",
    "css-custom-properties",
    "wcag"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "tympan-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "default": "./dist/values.js"
    },
    "./print-aliases": {
      "tympan-source": "./src/print-aliases.ts",
      "types": "./dist/print-aliases.d.ts",
      "default": "./dist/print-aliases.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./print-themes.css": "./dist/print-themes.css",
    "./print-themes/*": "./dist/print-themes/*",
    "./print-themes.json": "./dist/print-themes.json",
    "./tokens.json": "./dist/tokens.json",
    "./themes.json": "./dist/themes.json",
    "./dtcg/*": "./dist/dtcg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
