{
  "name": "@fakhir/tokens",
  "version": "0.1.0",
  "description": "Fakhir design tokens: W3C DTCG source (colour, space, radius, type, elevation and glass, motion, z) with neutral and fakhir themes in light and dark, built to --fk-* CSS custom properties and a TypeScript export.",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "fakhir-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "default": "./dist/values.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./dtcg/*": "./dist/dtcg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  }
}
